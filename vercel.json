{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/marketing.php",
      "destination": "/api/marketing.php"
    },
    {
      "source": "/noticia.php",
      "destination": "/api/noticia.php"
    }
  ]
}